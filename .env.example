# intern-outreach configuration

# Daily sending limits & delays
DAILY_EMAIL_CAP=30
DELAY_MIN_SECONDS=60
DELAY_MAX_SECONDS=180

# Safety flags (always true by default; dry-run prevents real emails from being sent)
DRY_RUN=true

# Database
DATABASE_URL=sqlite:///intern_outreach.db

# LLM Provider Configuration ("gemini" or "ollama")
LLM_PROVIDER=gemini

# Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Email Credentials (future stages)
# GMAIL_CLIENT_SECRET_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json
